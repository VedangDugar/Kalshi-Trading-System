# Copy to `.env` and fill in if you want to pull REAL data.
# Everything works without these set - the system falls back to synthetic data.

# NOAA / NCEI Climate Data Online token (free): https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# Demo market configuration (optional overrides)
CITY=NYC
NOAA_STATION=KNYC
TEMP_THRESHOLD_F=90
MARKET_ID=NYC-HIGH-90F

# Bankroll / sizing
BANKROLL_USD=5000
KELLY_FRACTION=0.5
